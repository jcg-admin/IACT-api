# IACT Call Center — Template de variables de entorno
# ── Desarrollo ─────────────────────────────────────────────────────────────
# DJANGO_SETTINGS_MODULE=config.settings.development
# ── Producción ──────────────────────────────────────────────────────────────
# DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=iact_analytics
DB_USER=django_user
DB_PASSWORD=django_pass
DB_HOST=localhost
DB_PORT=5432
# DB_SOCKET=/var/run/postgresql  # activo → socket Unix, ignora HOST/PORT

IVR_DB_NAME=ivr_legacy
IVR_DB_USER=django_user
IVR_DB_PASSWORD=django_pass
IVR_DB_HOST=localhost
IVR_DB_PORT=3306
IVR_DB_SOCKET=/run/mysqld/mysqld.sock

IVR_QUERY_TIMEOUT_SEC=30

# PROHIBIDO: EMAIL_* SENTRY_* REDIS_* CELERY_* CHANNELS_* (CNST v2.2.1)
