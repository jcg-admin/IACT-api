# ==============================================================================
# IACT-api — .env de producción (esta instancia)
# Secretos y valores específicos de la instancia.
# Decisiones de configuración → config/settings/production.py
# ==============================================================================

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=django-insecure-dev-key-CHANGE-IN-PRODUCTION-abc123xyz
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# PostgreSQL — BD principal (iact_analytics)
# DB_SOCKET activo → socket Unix. DB_HOST/PORT ignorados.
# ==============================================================================
DB_NAME=iact_analytics
DB_USER=django_user
DB_PASSWORD=django_pass
DB_SOCKET=/var/run/postgresql

# ==============================================================================
# MariaDB — IVR Legacy (ivr_legacy, READ-ONLY)
# ==============================================================================
IVR_DB_NAME=ivr_legacy
IVR_DB_USER=django_user
IVR_DB_PASSWORD=django_pass
IVR_DB_SOCKET=/run/mysqld/mysqld.sock

# ==============================================================================
# Pipeline IVR
# ==============================================================================
IVR_QUERY_TIMEOUT_SEC=30
